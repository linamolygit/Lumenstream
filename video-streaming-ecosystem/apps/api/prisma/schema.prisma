generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum VideoStatus {
  active
  hidden
  dead
  processing
}

model User {
  id               BigInt    @id @default(autoincrement())
  name             String    @db.VarChar(120)
  email            String    @unique @db.VarChar(190)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             Role      @default(user)
  resetTokenHash   String?   @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  scrapedVideos Video[] @relation("ScrapedBy")

  @@map("users")
}

model Video {
  id               BigInt      @id @default(autoincrement())
  uuid             String      @unique @db.VarChar(36)
  title            String      @db.VarChar(500)
  slug             String      @unique @db.VarChar(255)
  description      String?     @db.Text

  sourcePageUrl    String?     @map("source_page_url") @db.VarChar(1000)
  sourceSite       String?     @map("source_site") @db.VarChar(100)

  duration         Int         @default(0)
  views            Int         @default(0)
  sourceViews      String?     @map("source_views") @db.VarChar(50)

  channelName      String?     @map("channel_name") @db.VarChar(255)
  channelUrl       String?     @map("channel_url") @db.VarChar(500)
  channelLogo      String?     @map("channel_logo") @db.VarChar(1000)

  thumbnail        String?     @db.VarChar(1000)
  thumbnails       Json?
  sprite           String?     @db.VarChar(1000)
  previewVideos    Json?       @map("preview_videos")

  m3u8Links        Json?       @map("m3u8_links")
  directVideoLinks Json?       @map("direct_video_links")

  status           VideoStatus @default(active)
  isFeatured       Boolean     @default(false) @map("is_featured")
  lastCheckedAt    DateTime?   @map("last_checked_at")

  scrapedById      BigInt?     @map("scraped_by_id")
  scrapedBy        User?       @relation("ScrapedBy", fields: [scrapedById], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([views])
  @@index([channelName])
  @@map("videos")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
